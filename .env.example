# Pooled runtime connection (Supabase transaction pooler, port 6543).
# Used by the application on Vercel. Do not commit a real password.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Direct connection for Prisma migrations (port 5432). Not used for request traffic.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require"

# Optional. Leave unset unless a host requires certificate verification.
# DATABASE_SSL_REJECT_UNAUTHORIZED="true"

AUTH_SECRET="generate-a-32-character-random-secret"
AUTH_URL="http://localhost:3000"
CUSTOMER_JWT_SECRET="generate-a-separate-32-character-secret"

# Client demos only. When true, the admin UI opens without signing in.
# Keep false (or unset) on any shared or production deployment.
OPEN_DASHBOARD="false"

# Local demos only. When true, reads use built-in sample records instead of Postgres.
USE_SAMPLE_DB="false"

# Production administrator. Used only by `npm run db:seed`. Never commit a real password.
ADMIN_EMAIL="admin@aig.local"
ADMIN_PASSWORD=""
ADMIN_NAME="AIG Administrator"

# Demo administrator. Server-side only. Never prefix these with NEXT_PUBLIC_.
# Set DEMO_TENANT_ENABLED=true only in the shell that runs npm run demo:create.
# Leave the password empty in this file. Put the real value in the shell or in Vercel.
DEMO_TENANT_ENABLED="false"
DEMO_MODE="false"
AIG_RUNTIME="development"
DEMO_ADMIN_EMAIL="projectbuddy.code@gmail.com"
DEMO_ADMIN_PASSWORD=""
DEMO_AUDITOR_EMAIL="demo.auditor@example.com"
DEMO_AUDITOR_PASSWORD=""
# Optional password for synthetic customer accounts. Leave empty to store an unusable random hash.
DEMO_CUSTOMER_PASSWORD=""
