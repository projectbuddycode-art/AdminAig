generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Cloud tenant. Business rows also store `tenant` as "production" or "demo".
model Tenant {
  id          String             @id @default(cuid())
  key         String             @unique
  name        String
  kind        String
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  memberships TenantMembership[]
}

model TenantMembership {
  id        String   @id @default(cuid())
  tenantId  String
  adminId   String
  role      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([tenantId, adminId])
  @@index([adminId])
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String           @default("")
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Admin {
  id           String             @id @default(cuid())
  name         String
  email        String             @unique
  passwordHash String
  role         String             @default("ADMIN")
  status       String             @default("ACTIVE")
  tenant       String             @default("production")
  lastLoginAt  DateTime?          @db.Timestamptz(3)
  deletedAt    DateTime?          @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  memberships  TenantMembership[]

  @@index([status])
  @@index([tenant])
  @@index([deletedAt])
}

model Customer {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  phone                String
  passwordHash         String
  status               String                @default("ACTIVE")
  tenant               String                @default("production")
  demoLabel            String?
  emailVerified        Boolean               @default(false)
  loginMethod          String                @default("PASSWORD")
  source               String                @default("ADMIN")
  lastLoginAt          DateTime?             @db.Timestamptz(3)
  passwordChangedAt    DateTime?             @db.Timestamptz(3)
  complimentaryCredits Int                   @default(0)
  deletedAt            DateTime?             @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  profile              CustomerProfile?
  subscriptions        Subscription[]
  machines             Machine[]
  assignments          MachineAssignment[]
  usageEntries         UsageEntry[]
  payments             Payment[]
  notifications        NotificationMessage[]
  loginEvents          LoginEvent[]
  recordingSessions    RecordingSession[]
  processingJobs       ProcessingJob[]
  exportRecords        ExportRecord[]
  tickets              SupportTicket[]

  @@index([status])
  @@index([createdAt])
  @@index([tenant])
  @@index([deletedAt])
}

model CustomerProfile {
  id         String    @id @default(cuid())
  customerId String    @unique
  company    String    @default("")
  city       String    @default("")
  notes      String    @default("")
  deletedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Plan {
  id            String                @id @default(cuid())
  name          String
  description   String                @default("")
  durationDays  Int
  status        String                @default("ACTIVE")
  featuresJson  String                @default("{}")
  priceCents    Int                   @default(0)
  priceAmount   Decimal               @default(0) @db.Decimal(12, 2)
  currency      String                @default("INR")
  tenant        String                @default("production")
  deletedAt     DateTime?             @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)
  subscriptions Subscription[]
  history       SubscriptionHistory[]

  @@index([status])
  @@index([tenant])
  @@index([deletedAt])
}

model Subscription {
  id                   String                @id @default(cuid())
  customerId           String
  planId               String
  status               String                @default("ACTIVE")
  startDate            DateTime              @db.Timestamptz(3)
  expiryDate           DateTime              @db.Timestamptz(3)
  renewalDate          DateTime?             @db.Timestamptz(3)
  exportAllowance      Int                   @default(0)
  exportsUsed          Int                   @default(0)
  creditsRemaining     Int                   @default(0)
  snapshotFeaturesJson String                @default("{}")
  tenant               String                @default("production")
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  customer             Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan                 Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments             Payment[]
  history              SubscriptionHistory[]

  @@index([customerId, status])
  @@index([planId])
  @@index([expiryDate])
  @@index([status])
  @@index([tenant])
}

/// Frozen plan terms captured when a subscription is opened or replaced.
model SubscriptionHistory {
  id                   String       @id @default(cuid())
  subscriptionId       String
  planId               String
  tenant               String
  status               String
  snapshotFeaturesJson String
  priceAmount          Decimal      @db.Decimal(12, 2)
  priceCents           Int
  reason               String?
  recordedAt           DateTime     @default(now()) @db.Timestamptz(3)
  subscription         Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  plan                 Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, recordedAt])
  @@index([tenant, recordedAt])
}

model Machine {
  id                  String                   @id @default(cuid())
  machineId           String                   @unique
  customerId          String?
  status              String                   @default("UNASSIGNED")
  firmwareVersion     String?
  model               String                   @default("DiamondCam")
  serialNumber        String?
  hardwareRevision    String?
  healthStatus        String                   @default("UNKNOWN")
  motorConfig         String                   @default("{}")
  lightingConfig      String                   @default("{}")
  lastSeenAt          DateTime?                @db.Timestamptz(3)
  telemetryVerified   Boolean                  @default(false)
  telemetrySimulated  Boolean                  @default(false)
  tenant              String                   @default("production")
  demoLabel           String?
  deletedAt           DateTime?                @db.Timestamptz(3)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  customer            Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignments         MachineAssignment[]
  usageEntries        UsageEntry[]
  maintenance         MaintenanceRecord[]
  errors              MachineError[]
  firmwareHistory     MachineFirmwareHistory[]
  configRevisions     MachineConfigRevision[]
  recordingSessions   RecordingSession[]
  processingJobs      ProcessingJob[]

  @@index([customerId])
  @@index([status])
  @@index([tenant])
  @@index([deletedAt])
}

model MachineAssignment {
  id           String    @id @default(cuid())
  machineId    String
  customerId   String
  tenant       String    @default("production")
  assignedAt   DateTime  @default(now()) @db.Timestamptz(3)
  unassignedAt DateTime? @db.Timestamptz(3)
  status       String    @default("ACTIVE")
  machine      Machine   @relation(fields: [machineId], references: [id], onDelete: Restrict)
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([machineId, status])
  @@index([customerId, status])
  @@index([tenant])
}

model MachineFirmwareHistory {
  id         String   @id @default(cuid())
  machineId  String
  version    String
  source     String   @default("ADMIN")
  recordedAt DateTime @default(now()) @db.Timestamptz(3)
  machine    Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId, recordedAt])
}

model MachineConfigRevision {
  id             String   @id @default(cuid())
  machineId      String
  motorConfig    String
  lightingConfig String
  recordedAt     DateTime @default(now()) @db.Timestamptz(3)
  machine        Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId, recordedAt])
}

model ActivityLog {
  id            String   @id @default(cuid())
  event         String
  actorType     String
  actorId       String?
  actorEmail    String?
  adminRole     String?
  targetType    String
  targetId      String
  customerId    String?
  machineRef    String?
  metadata      String   @default("{}")
  previousValue String?
  newValue      String?
  reason        String?
  result        String   @default("SUCCESS")
  ipAddress     String?
  userAgent     String?
  tenant        String   @default("production")
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([event])
  @@index([targetType, targetId])
  @@index([actorId])
  @@index([tenant])
  @@index([customerId])
}

model LoginEvent {
  id         String    @id @default(cuid())
  tenant     String    @default("production")
  actorType  String
  actorId    String?
  email      String
  success    Boolean
  method     String    @default("PASSWORD")
  ipAddress  String?
  userAgent  String?
  sessionId  String?
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenant, createdAt])
  @@index([email])
  @@index([actorId])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  tenant    String   @default("production")
  actorType String
  actorId   String?
  email     String
  kind      String
  detail    String   @default("")
  ipAddress String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenant, createdAt])
  @@index([email])
}

/// Usage ledger. `idempotencyKey` rejects a repeated export charge.
model UsageEntry {
  id              String          @id @default(cuid())
  tenant          String          @default("production")
  customerId      String
  machineId       String?
  processingJobId String?
  jobId           String
  idempotencyKey  String          @unique
  sourceRecording String?
  preset          String?
  status          String
  startedAt       DateTime        @db.Timestamptz(3)
  completedAt     DateTime?       @db.Timestamptz(3)
  durationMs      Int?
  creditsConsumed Int             @default(0)
  storageMb       Int?
  exportDate      DateTime?       @db.Timestamptz(3)
  outputRef       String?
  failureReason   String?
  charged         Boolean         @default(false)
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  machine         Machine?        @relation(fields: [machineId], references: [id], onDelete: SetNull)
  processingJob   ProcessingJob?  @relation(fields: [processingJobId], references: [id], onDelete: SetNull)
  exportRecord    ExportRecord?
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([tenant, jobId])
  @@index([customerId, createdAt])
  @@index([status])
  @@index([tenant])
}

model RecordingSession {
  id          String          @id @default(cuid())
  tenant      String          @default("production")
  customerId  String
  machineId   String?
  sessionKey  String
  status      String
  startedAt   DateTime        @db.Timestamptz(3)
  endedAt     DateTime?       @db.Timestamptz(3)
  storageMb   Int?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  machine     Machine?        @relation(fields: [machineId], references: [id], onDelete: SetNull)
  jobs        ProcessingJob[]

  @@unique([tenant, sessionKey])
  @@index([customerId, startedAt])
  @@index([tenant])
}

model ProcessingJob {
  id                 String            @id @default(cuid())
  tenant             String            @default("production")
  customerId         String
  machineId          String?
  recordingSessionId String?
  jobKey             String
  status             String
  startedAt          DateTime          @db.Timestamptz(3)
  completedAt        DateTime?         @db.Timestamptz(3)
  failureReason      String?
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  machine            Machine?          @relation(fields: [machineId], references: [id], onDelete: SetNull)
  recordingSession   RecordingSession? @relation(fields: [recordingSessionId], references: [id], onDelete: SetNull)
  usageEntries       UsageEntry[]
  exports            ExportRecord[]

  @@unique([tenant, jobKey])
  @@index([customerId, startedAt])
  @@index([status])
  @@index([tenant])
}

model ExportRecord {
  id              String         @id @default(cuid())
  tenant          String         @default("production")
  customerId      String
  processingJobId String?
  usageEntryId    String?        @unique
  idempotencyKey  String         @unique
  status          String
  creditsConsumed Int            @default(0)
  outputRef       String?
  simulated       Boolean        @default(false)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  processingJob   ProcessingJob? @relation(fields: [processingJobId], references: [id], onDelete: SetNull)
  usageEntry      UsageEntry?    @relation(fields: [usageEntryId], references: [id], onDelete: SetNull)

  @@index([tenant, createdAt])
  @@index([customerId])
  @@index([status])
}

model Payment {
  id             String        @id @default(cuid())
  tenant         String        @default("production")
  customerId     String
  subscriptionId String?
  amountCents    Int
  amount         Decimal       @default(0) @db.Decimal(12, 2)
  currency       String        @default("INR")
  status         String
  method         String
  reference      String
  invoiceNumber  String?
  simulated      Boolean       @default(false)
  demoLabel      String?
  paidAt         DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  refunds        Refund[]

  @@index([tenant, createdAt])
  @@index([customerId])
  @@index([status])
  @@index([reference])
}

model Refund {
  id          String   @id @default(cuid())
  tenant      String   @default("production")
  paymentId   String
  amountCents Int
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("INR")
  status      String
  reason      String
  simulated   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([tenant, createdAt])
  @@index([paymentId])
}

model NotificationMessage {
  id             String                 @id @default(cuid())
  tenant         String                 @default("production")
  customerId     String?
  channel        String
  templateKey    String
  subject        String
  body           String
  status         String
  simulated      Boolean                @default(false)
  error          String?
  idempotencyKey String?                @unique
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  sentAt         DateTime?              @db.Timestamptz(3)
  customer       Customer?              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deliveries     NotificationDelivery[]

  @@index([tenant, createdAt])
  @@index([customerId])
  @@index([status])
}

model NotificationDelivery {
  id             String              @id @default(cuid())
  notificationId String
  attempt        Int
  status         String
  error          String?
  attemptedAt    DateTime            @default(now()) @db.Timestamptz(3)
  notification   NotificationMessage @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, attempt])
}

model SupportTicket {
  id         String                 @id @default(cuid())
  tenant     String                 @default("production")
  customerId String
  subject    String
  status     String
  priority   String                 @default("NORMAL")
  deletedAt  DateTime?              @db.Timestamptz(3)
  createdAt  DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime               @updatedAt @db.Timestamptz(3)
  customer   Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages   SupportTicketMessage[]

  @@index([tenant, status])
  @@index([customerId])
}

model SupportTicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  authorType String
  body       String
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model IntegrationConfig {
  id         String   @id @default(cuid())
  tenant     String
  provider   String
  status     String   @default("DISABLED")
  configJson String   @default("{}")
  simulated  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([tenant, provider])
  @@index([tenant])
}

model MaintenanceRecord {
  id          String   @id @default(cuid())
  machineId   String
  tenant      String   @default("production")
  note        String
  performedBy String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  machine     Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId])
  @@index([tenant, createdAt])
}

model MachineError {
  id        String   @id @default(cuid())
  machineId String
  tenant    String   @default("production")
  code      String
  message   String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  machine   Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId])
  @@index([tenant, createdAt])
}
